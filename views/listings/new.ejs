<% layout('layouts/boilerplate') %>

    <body>

        <div class="row col-8 mx-auto">
            <h3>Add New Plot</h3>
            <form method="POST" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
                <div>
                    <label for="title" class="form-label">Title</label>
                    <input name="new[title]" type="text" placeholder="Enter Type" class="form-control" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please Enter title
                    </div>
                </div>
                <div>
                    <label for="description" class="form-label">Description</label>
                    <textarea name="new[description]" type="text" placeholder="Enter Description" class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">
                        Please Write a breif Description
                    </div>
                </div>
                <div>
                    <label for="new[file]" class="form-label">Enter Image</label>
                    <input name="new[file]" type="file" placeholder="Select File" class="form-control" required>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="new[price]" type="number" placeholder="Enter Type" class="form-control" required>
                        <div class="invalid-feedback">
                            Please enter rent.
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label for="new[country]" class="form-label">Country</label>
                        <input name="new[country]" type="text" placeholder="Enter Country" class="form-control"
                            required>
                        <div class="invalid-feedback">
                            Please Enter Country
                        </div>
                    </div>
                </div>

                <div>
                    <label for="new[location]" class="form-label">Location</label>
                    <input name="new[location]" type="text" placeholder="Enter Location" class="form-control" required>
                    <div class="invalid-feedback">
                        Please Enter Location
                    </div>
                </div>
                <button class="btn btn-dark">ADD</button>
        </div>
        </form>
    </body>