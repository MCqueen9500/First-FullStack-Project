<% layout('layouts/boilerplate') %>


   <body>

      <div class="show-div">

         <div class="show-card" style="width: 18rem;">
            <h4><b>
                  <%= list.title %>
               </b></h4>
            <div class="img-div">
               <img src="<%= list.image.url %>" class="card-img-top" alt="...">
            </div>

            <div class="card-body">
               <div class="description">
                  <p>
                     <%= list.description %>
                  </p>
               </div>
               <b> &#x20B9; <%= list.price ? list.price.toLocaleString("en-IN") : "N/A" %></b>
               <p>
                  <%= list.location %>
               </p>
               <b>
                  <%= list.country %>
               </b>
            </div>
         </div>
         <br>

         <div class="btn-div">
            <a href="/listing/<%=list._id%>/edit" class="btn btn-dark change-btn">Edit Information</a>
            <br><br>

            <form method="POST" action="/listing/<%=list._id%>?_method=DELETE">
               <button class="btn btn-danger">Delet this Listing</button>
            </form>
         </div>
         <hr>
         <div class="col-4">
            <form action="/listing/<%= list._id %>/review" method="POST" class="needs-validation" novalidate>
               <label for="rating" class="form-label">Rating</label>
               <br>
               <input type="range" id="rating" min="1" max="5" class="form-range" name="review[rating]">
               <br>
               <label for="comment" class="form-label">Comment</label>
               <br>
               <input type="textarea" id="comment" class="form-control" style="height: 4rem" name="review[comment]" required>
               <div class="invalid-feedback">please add comments</div>
               <button class="btn btn-outline-primary">Add+</button>
            </form>
         </div>
      </div>
      <br>
      <hr>
      <div class="show-reviews-contaner ">
         
         <% for (let obj of list.reviews) { %>
         <div class="show-reviews">
             <div class=" rating"><i><%= obj.rating %> <% for(let i = 0;i<obj.rating;i++){ %><i class="fa-solid fa-star" style="color: rgb(201, 229, 244);"></i> <% } %></i></div>
            <div class="comment overflow-auto"><b><%= obj.comment %></b></div>
            
            <form method="post" action="/listing/<%= list._id %>/review/<%=obj._id%>?_method=DELETE">
               <button class="btn btn-dark review-del">Delete</button><div class=" date"><%= obj.created_at %></div>
            </form>

         </div>
         <hr>
      <% } %>
      </div>
   </body>