<% layout('layouts/boilerplate') %>

   <body>

      <div class="show-div col-8 mx-auto">

         <div class="show-card">
            <h4><b>
                  <%= list.title %>
               </b></h4>
            <div class="img-div" style="background-image: url('<%= list.image.url %>');">

            </div>

            <div class="card-body">
               <p>Created By:<b>
                     <%= list.owner.username %>
                  </b></p>
               <div class="description">
                  <p>
                     <%= list.description %>
                  </p>
               </div>
               <b> &#x20B9; <%= list.price ? list.price.toLocaleString("en-IN") : "N/A" %></b>
               <p id="listlocation">
                  <%= list.location %>
               </p>
               <b>
                  <%= list.country %>
               </b>
            </div>
         </div>
         <% if(loginUser && loginUser._id.equals(list.owner._id)){%>
            <br>
            <div class="btn-div">
               <a href="/listing/<%=list._id%>/edit" class="btn btn-dark change-btn">Edit Information</a>
               <br><br>

               <form method="POST" action="/listing/<%=list._id%>?_method=DELETE">
                  <button class="btn btn-danger">Delet this Listing</button>
               </form>
            </div>
            <% } %>
               <div style="width:100%;margin:auto">
                  <hr>
               </div>
               <% if(loginUser){ %>
                  <div style="width:100%;margin:auto">
                     <h4>Add a Review</h4>
                     <br>
                     <form action="/listing/<%= list._id %>/review" method="POST" class="needs-validation" novalidate>
                        <label for="rating" class="form-label">Rating</label>
                        <br>
                        <fieldset class="starability-slot">
                           <input type="radio" id="first-rate1" name="review[rating]" value="1" required checked />
                           <label for="first-rate1" title="Terrible">1 star</label>
                           <input type="radio" id="first-rate2" name="review[rating]" value="2" required />
                           <label for="first-rate2" title="Not good">2 stars</label>
                           <input type="radio" id="first-rate3" name="review[rating]" value="3" required />
                           <label for="first-rate3" title="Average">3 stars</label>
                           <input type="radio" id="first-rate4" name="review[rating]" value="4" required />
                           <label for="first-rate4" title="Very good">4 stars</label>
                           <input type="radio" id="first-rate5" name="review[rating]" value="5" required />
                           <label for="first-rate5" title="Amazing">5 stars</label>
                           <div class="invalid-feedback">Select Rating</div>
                        </fieldset>
                        <label for="comment" class="form-label">Comment</label>
                        <br>
                        <input type="textarea" id="comment" class="form-control" style="height: 4rem"
                           name="review[comment]" required>
                        <div class="invalid-feedback">please add comments</div>
                        <button class="btn btn-outline-primary">Add+</button>
                     </form>
                  </div>
                  <% } %>

                     <br>
                     <hr>
                     <div class="show-reviews-contaner">

                        <% for (let obj of list.reviews) { %>
                           <div class="show-reviews">
                              <p style="margin: 0 0 0.3rem 0;"><b>@<%= obj.created_by.username%></b>
                              </p>
                              <div class=" rating"><i>
                                    <p class="starability-result" data-rating="<%= obj.rating %>">
                                       Rated: 3 stars
                                    </p>
                                 </i></div>
                              <div class="comment overflow-auto"><b>
                                    <%= obj.comment %>
                                 </b></div>

                              <form method="post" action="/listing/<%= list._id %>/review/<%=obj._id%>?_method=DELETE">
                                 <button class="btn btn-dark review-del">Delete</button>
                                 <div class=" date">
                                    <%= obj.created_at %>
                                 </div>
                              </form>

                           </div>
                           <hr>
                           <% } %>
                     </div>
                     <div class="map_div col-12" style="height: 25rem;">
                        <div id="map"></div>
                     </div>
                     <br>
                     
      </div>
   </body>