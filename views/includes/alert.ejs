<% if ( failureMsg.length > 0 || successMsg.length > 0) { %>
    <br>
<% } %>


<% if(typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show col-6 offset-3 align" role="alert">
        <%= successMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if ( failureMsg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 align" role="alert">
        <%= failureMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>